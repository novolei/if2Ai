{
  "productName": "If2Ai",
  "version": "0.1.0",
  "identifier": "dev.if2ai.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "If2Ai - AI Agent Desktop",
        "url": "http://localhost:1430",
        "width": 1200,
        "height": 900,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true
  }
}
