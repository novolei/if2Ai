{
    "identifier": "settings-window",
    "description": "Permissions for the settings window",
    "windows": [
        "settings"
    ],
    "permissions": [
        "core:default",
        "core:event:default",
        "core:event:allow-emit",
        "core:event:allow-listen",
        "core:window:default",
        "core:window:allow-start-dragging",
        "dialog:default",
        "dialog:allow-open"
    ]
}