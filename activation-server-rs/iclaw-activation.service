[Unit]
Description=iClaw Activation Server (Rust)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/iclaw-activation-server
EnvironmentFile=/opt/iclaw-activation-server/.env
ExecStart=/opt/iclaw-activation-server/bin/iclaw-activation-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/iclaw-activation-server

[Install]
WantedBy=multi-user.target
