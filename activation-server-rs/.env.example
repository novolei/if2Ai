BIND_ADDR=127.0.0.1:78789
DATABASE_URL=sqlite:///opt/iclaw-activation-server/data/activation.db
# 多客户端白名单（与 UClaw 一致）：逗号分隔，优先级高于单值 APP_ID。
# if2Ai 桌面端使用 app_id = ai.if2.if2Ai（见 if2Ai `license_lifecycle_service::APP_ID`）。
APP_IDS=com.wt.iClaw,ai.if2.UClaw,ai.if2.if2Ai
# 仅单应用时使用（无 APP_IDS 时回退；若已设置 APP_IDS 则忽略）：
# APP_ID=com.wt.iClaw
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SIGNING_KEY_ID=k1
# 32-byte secret, base64url(no-pad). Generate:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SIGNING_KEY_B64=replace-me
LICENSE_VALID_DAYS=7
OFFLINE_GRACE_HOURS=72
REFRESH_AFTER_SEC=86400
REQ_LIMIT_PER_MIN=30
REDEEM_LIMIT_PER_MIN=20
REFRESH_LIMIT_PER_MIN=60
ADMIN_LOGIN_LIMIT_PER_MIN=20
MAX_INFLIGHT_WRITES=200
READINESS_MIN_INFLIGHT=5
