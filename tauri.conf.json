{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "If2Ai",
        "width": 1200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "package": {
    "productName": "If2Ai",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "If2Ai - AI Agent Desktop",
        "url": "http://localhost:1430",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  }
}
